{
  "compilerOptions": {
    "target": "es2018",
    "module": "commonjs", 
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": ["scripts/**/*","src/**/*"],
  "exclude": ["node_modules"]
}